#include <windows.h>
#include "resource.h"

// Keep branding first: profile registration uses zero-based icon index 0.
IDI_CANTONESE_BRAND ICON "icons/cantonese.ico"
IDI_CANTONESE_MODE ICON "icons/mode-cantonese.ico"
IDI_ENGLISH_MODE ICON "icons/mode-english.ico"

1 VERSIONINFO
 FILEVERSION CIME_VERSION_MAJOR,CIME_VERSION_MINOR,CIME_VERSION_PATCH,0
 PRODUCTVERSION CIME_VERSION_MAJOR,CIME_VERSION_MINOR,CIME_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Cantonese IME Project\0"
      VALUE "FileDescription", "Cantonese IME for Windows x64\0"
      VALUE "FileVersion", CIME_VERSION_STRING "\0"
      VALUE "InternalName", "CantoneseIME\0"
      VALUE "OriginalFilename", "CantoneseIME.dll\0"
      VALUE "ProductName", "Cantonese IME\0"
      VALUE "ProductVersion", CIME_VERSION_STRING "\0"
      VALUE "LegalCopyright", "Copyright 2026 Cantonese IME contributors\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
