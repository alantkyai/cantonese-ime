#include <windows.h>
#include "../tsf/resource.h"

1 ICON "../tsf/icons/cantonese.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "settings.manifest"

1 VERSIONINFO
 FILEVERSION CIME_VERSION_MAJOR,CIME_VERSION_MINOR,CIME_VERSION_PATCH,0
 PRODUCTVERSION CIME_VERSION_MAJOR,CIME_VERSION_MINOR,CIME_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Cantonese IME Project\0"
      VALUE "FileDescription", "Cantonese IME Settings\0"
      VALUE "FileVersion", CIME_VERSION_STRING "\0"
      VALUE "InternalName", "CantoneseImeSettings\0"
      VALUE "OriginalFilename", "CantoneseImeSettings.exe\0"
      VALUE "ProductName", "Cantonese IME\0"
      VALUE "ProductVersion", CIME_VERSION_STRING "\0"
      VALUE "LegalCopyright", "Copyright 2026 Cantonese IME contributors\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
