        "Sidney Lau"
      ],
      "max_onset_rewrites": 1,
      "max_rule_steps": 2,
      "narrowing_from_prototype": "Forbid composing alternative onset conventions, including zaa->jaa->yaa. Onset+final combinations such as caa->chaa->cha remain.",
      "strict_mode": "jyutping",
      "tone_policy": "Numeric tone1..6 is passed through unchanged; aliases never substitute tones or imply all six tones are attested."
    },
