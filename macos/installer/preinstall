#!/bin/sh
# No user preferences, input sources, processes, or learning files are changed.
set -eu
target_volume=${3:-/}
if [ "$target_volume" != / ]; then
  echo 'Install Cantonese IME on the current macOS startup volume.' >&2
  exit 1
fi
app='/Library/Input Methods/CantoneseIME.app'
if [ -L "$app" ]; then
  echo 'The installation path is a symbolic link; refusing replacement.' >&2
  exit 1
fi
if [ -e "$app" ]; then
  identity=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app/Contents/Info.plist")
  if [ "$identity" != org.cantoneseime.inputmethod.CantoneseIME ]; then
    echo 'The destination belongs to a different application.' >&2
    exit 1
  fi
  # Refuse an upgrade while this IMK server or its private interpreter is in
  # use. No broad process termination or modification of user login state.
  if /bin/ps -axo command= | /usr/bin/grep -F "/Library/Input Methods/CantoneseIME.app/Contents/MacOS/" | /usr/bin/grep -v '/usr/bin/grep' >/dev/null; then
    echo 'Switch to another input source and quit Cantonese IME, or sign out other users, before upgrading.' >&2
    exit 1
  fi
fi
exit 0
